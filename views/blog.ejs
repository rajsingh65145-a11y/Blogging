<!DOCTYPE html>
<html lang="en">
<head>
    <%-include('./partials/head')%>
    <title>Blog Page</title>
</head>
<body>
    <%-include('./partials/nav')%>


<div class="container mt-4 ">
    <h1><%= blog.title %></h1>
    <img src="<%= blog.coverImageURL %>"  width="700px" alt="">
    <pre class="mt-3"><%= blog.body %></pre>
</div>

<div class="container mt-4 ">
    <img src="<%= blog.createdBy.profileImageURL %>" width="100px" alt="">
    <%= blog.createdBy.fullName %>
</div>

<div class="container mt-3">
    <h1>Comments (<%= locals.comments ? comments.length : 0 %>)</h1>
    <% if (locals.user) { %>
        <form action="/blog/comment/<%= blog._id %>" method="post">
            <div class="mb-3">
                <input type="text" name="content" class="form-control" placeholder="Enter Your Comment">
                <button class="btn btn-sm btn-primary mt-2" type="submit">Add</button>
            </div>
        </form>
    <% } %>
    <div class="mt-3">
        <% if (locals.comments) { %>
            <% comments.forEach(comment => { %>
                <div class="mb-3">
                    <img src="<%= comment.createdBy.profileImageURL %>" width="50px" style="border-radius: 50%;" alt="">
                    <%= comment.createdBy.fullName %>
                    <pre class="mt-1"><%= comment.content %></pre>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>
        <%-include('./partials/scripts')%>

</body>
</html>