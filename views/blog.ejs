<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title><%= blog.title %> - Blogify</title>
    <style>
      .blog-content {
        font-size: 1.15rem;
        line-height: 1.9;
        color: #334155;
        white-space: pre-wrap;
        word-break: break-word;
        font-family: inherit;
      }
    </style>
</head>
<body>
    <%- include('./partials/nav') %>

    <div class="container my-5" style="max-width: 820px;">
        <!-- Title -->
               <!-- Title & Action Buttons -->
        <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
            <h1 class="display-5 fw-extrabold text-dark mb-0"><%= blog.title %></h1>

            <!-- Sirf wahi user delete button dekhega jisne ye blog banaya hai -->
            <% if (locals.user && blog.createdBy && (locals.user._id.toString() === blog.createdBy._id.toString() || locals.user.role === 'ADMIN')) { %>
                <form action="/blog/delete/<%= blog._id %>" method="POST" onsubmit="return confirm('Kya aap sach me ye blog delete karna chahte hain?');">
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2 text-nowrap shadow-sm">
                        <i class="bi bi-trash3 me-1"></i> Delete Blog
                    </button>
                </form>
            <% } %>
        </div>

        <!-- Author Info -->
        <div class="d-flex align-items-center gap-3 pb-4 mb-4 border-bottom">
            <img src="<%= blog.createdBy.profileImageURL || '/images/default.png' %>" class="avatar" width="56" height="56" alt="<%= blog.createdBy.fullName %>" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(blog.createdBy.fullName) %>&background=6366f1&color=fff'">
            <div>
                <h6 class="mb-0 fw-bold"><%= blog.createdBy.fullName %></h6>
                <small class="text-muted"><i class="bi bi-person-badge me-1"></i> Author</small>
            </div>
        </div>

        <!-- Cover Image -->
        <div class="mb-5 rounded-4 overflow-hidden shadow-sm">
            <img src="<%= blog.coverImageURL %>" class="w-100 img-fluid" style="max-height: 460px; object-fit: cover;" alt="<%= blog.title %>" onerror="this.src='https://images.unsplash.com/photo-1499750310107-5fef28a66643?q=80&w=1200&auto=format&fit=crop'">
        </div>

        <!-- Blog Body -->
        <div class="blog-content mb-5">
<%= blog.body %>
        </div>

        <!-- Comments Section -->
        <section class="mt-5 pt-4 border-top">
            <div class="d-flex align-items-center gap-2 mb-4">
                <h3 class="fw-bold mb-0">Discussion</h3>
                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">
                    <%= locals.comments ? comments.length : 0 %> Comments
                </span>
            </div>

            <!-- Comment Input Form -->
            <% if (locals.user) { %>
                <div class="card border-0 shadow-sm p-3 mb-4 rounded-4 bg-white">
                    <form action="/blog/comment/<%= blog._id %>" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Share your thoughts</label>
                            <input type="text" name="content" class="form-control" placeholder="Write a comment..." required>
                        </div>
                        <div class="text-end">
                            <button class="btn btn-primary btn-sm px-4 rounded-pill" type="submit">
                                <i class="bi bi-send me-1"></i> Post Comment
                            </button>
                        </div>
                    </form>
                </div>
            <% } else { %>
                <div class="alert alert-light border text-center py-3 rounded-4 mb-4">
                    <p class="mb-0 text-muted">Please <a href="/user/signin" class="fw-bold text-primary">Sign in</a> to join the conversation.</p>
                </div>
            <% } %>

            <!-- Comments List -->
            <div class="d-flex flex-column gap-3">
                <% if (locals.comments && comments.length > 0) { %>
                    <% comments.forEach(comment => { %>
                        <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <img src="<%= comment.createdBy.profileImageURL || '/images/default.png' %>" class="avatar" width="40" height="40" alt="<%= comment.createdBy.fullName %>" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(comment.createdBy.fullName) %>&background=6366f1&color=fff'">
                                <div>
                                    <h6 class="mb-0 fw-semibold text-dark"><%= comment.createdBy.fullName %></h6>
                                </div>
                            </div>
                            <p class="mb-0 text-secondary ps-5" style="white-space: pre-wrap;"><%= comment.content %></p>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-muted text-center py-4">No comments yet. Be the first to comment!</p>
                <% } %>
            </div>
        </section>
    </div>

    <%- include('./partials/scripts') %>
</body>
</html>