<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Blogify - Home</title>
</head>
<body>
    <%- include('./partials/nav') %>

    <!-- Hero / Welcome Section -->
    <header class="py-5 text-center bg-white border-bottom mb-4">
      <div class="container">
        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold mb-3">
          <i class="bi bi-sparkles me-1"></i> Explore Stories & Ideas
        </span>
        <h1 class="display-5 fw-bold text-dark">Welcome to Blogify</h1>
        <p class="lead text-muted mx-auto" style="max-width: 600px;">
          Discover insightful articles, creative stories, and thoughts written by passionate writers.
        </p>
      </div>
    </header>

    <!-- Blogs Grid -->
    <main class="container my-4 flex-grow-1">
      <% if (!blogs || blogs.length === 0) { %>
        <div class="text-center py-5">
          <i class="bi bi-journal-x display-1 text-muted"></i>
          <h3 class="mt-3 fw-bold">No blogs published yet</h3>
          <p class="text-muted">Be the first one to share an insightful story!</p>
          <% if (locals.user) { %>
            <a href="/blog/add-new" class="btn btn-primary mt-2">Write a Blog</a>
          <% } else { %>
            <a href="/user/signup" class="btn btn-primary mt-2">Create an Account</a>
          <% } %>
        </div>
      <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
          <% blogs.forEach(blog => { %>
            <div class="col">
              <article class="card custom-card h-100 border-0">
                <div style="height: 200px; overflow: hidden; background: #e2e8f0;">
                  <img src="<%= blog.coverImageURL %>" class="card-img-top w-100 h-100" style="object-fit: cover; transition: transform 0.4s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" alt="<%= blog.title %>" onerror="this.src='https://images.unsplash.com/photo-1499750310107-5fef28a66643?q=80&w=600&auto=format&fit=crop'">
                </div>
                <div class="card-body d-flex flex-column p-4">
                  <h5 class="card-title fw-bold text-dark mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    <%= blog.title %>
                  </h5>
                  <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                    <span class="text-muted small"><i class="bi bi-clock me-1"></i> Read Article</span>
                    <a href="/blog/<%= blog._id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                      Read <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>
              </article>
            </div>
          <% }) %>
        </div>
      <% } %>
    </main>

    <%- include('./partials/scripts') %>
</body>
</html>