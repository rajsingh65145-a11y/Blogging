        </li>
        <% if (locals.user) { %>
        <li class="nav-item">
          <a class="nav-link px-3" href="/blog/add-new"><i class="bi bi-plus-circle me-1"></i> Add Blog</a>
        </li>
        <% } %>
      </ul>

      <ul class="navbar-nav ms-auto align-items-center gap-2">
        <% if (locals.user) { %>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-white px-3 py-1 rounded-pill bg-white bg-opacity-10 border border-white border-opacity-10" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <img src="<%= locals.user.profileImageURL || '/images/default.png' %>" class="avatar" width="28" height="28" alt="Profile" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(locals.user.fullName) %>&background=6366f1&color=fff'">
