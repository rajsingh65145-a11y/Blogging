<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top py-3" style="border-bottom: 1px solid rgba(255,255,255,0.08); backdrop-filter: blur(8px);">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-4" href="/">
      <i class="bi bi-feather text-primary fs-3"></i>
      <span style="background: linear-gradient(135deg, #818cf8, #c084fc); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Blogify</span>
    </a>
    
    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
